{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecMeshHandoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state",
    "executable",
    "project",
    "task",
    "goals",
    "constraints",
    "decisions",
    "work_summary",
    "remaining_work",
    "next_step",
    "baseline",
    "dirty_coverage",
    "evidence_bindings",
    "issues"
  ],
  "properties": {
    "schema_version": {
      "enum": ["specmesh.handoff.v1"]
    },
    "state": {
      "enum": ["ready", "rejected", "stale", "cancelled", "blocked", "unknown"]
    },
    "executable": {
      "type": "boolean"
    },
    "project": {
      "$ref": "#/$defs/identity"
    },
    "task": {
      "$ref": "#/$defs/task"
    },
    "goals": {
      "$ref": "#/$defs/statements"
    },
    "constraints": {
      "$ref": "#/$defs/statements"
    },
    "decisions": {
      "$ref": "#/$defs/statements"
    },
    "work_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "failed", "unknown"],
      "properties": {
        "completed": {"$ref": "#/$defs/statements"},
        "failed": {"$ref": "#/$defs/statements"},
        "unknown": {"$ref": "#/$defs/statements"}
      }
    },
    "remaining_work": {
      "$ref": "#/$defs/statements"
    },
    "next_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "statement", "sources"],
      "properties": {
        "state": {"enum": ["selected", "unknown", "ambiguous"]},
        "statement": {
          "anyOf": [
            {"$ref": "#/$defs/statement"},
            {"type": "null"}
          ]
        },
        "sources": {
          "type": "array",
          "maxItems": 10,
          "items": {"$ref": "#/$defs/source"}
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_head", "expected_head", "head_matches", "scope_fingerprint", "coverage"],
      "properties": {
        "observed_head": {
          "anyOf": [
            {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
            {"type": "null"}
          ]
        },
        "expected_head": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "head_matches": {
          "type": "boolean"
        },
        "scope_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "coverage": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/coverage_item"}
        }
      }
    },
    "dirty_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_clean", "scope", "summary", "entries"],
      "properties": {
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task_path", "selected_paths", "outside_scope"],
          "properties": {
            "task_path": {"anyOf": [{"type": "string", "maxLength": 4096}, {"type": "null"}]},
            "selected_paths": {"type": "array", "maxItems": 64,
              "items": {"type": "string", "maxLength": 4096}},
            "outside_scope": {"enum": ["unknown"]}
          }
        },
        "is_clean": {"type": "boolean"},
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["staged_count", "unstaged_count", "untracked_count"],
          "properties": {
            "staged_count": {"type": "integer", "minimum": 0},
            "unstaged_count": {"type": "integer", "minimum": 0},
            "untracked_count": {"type": "integer", "minimum": 0}
          }
        },
        "entries": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/dirty_entry"}
        }
      }
    },
    "evidence_bindings": {
      "type": "array",
      "maxItems": 50,
      "items": {"$ref": "#/$defs/evidence_binding"}
    },
    "issues": {
      "type": "array",
      "maxItems": 200,
      "items": {"$ref": "#/$defs/issue"}
    }
  },
  "$defs": {
    "coverage_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "tracked", "modified"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^/\\u0000-\\u001f\\\\]+(?:/[^/\\u0000-\\u001f\\\\]+)*$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tracked": {"type": "boolean"},
        "modified": {"type": "boolean"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line_start", "line_end", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^/\\u0000-\\u001f\\\\]+(?:/[^/\\u0000-\\u001f\\\\]+)*$"
        },
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "authority", "source"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 4096},
        "authority": {"enum": ["asserted_candidate"]},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "statements": {
      "type": "array",
      "maxItems": 200,
      "items": {"$ref": "#/$defs/statement"}
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "value", "sources"],
      "properties": {
        "state": {"enum": ["known", "unknown"]},
        "value": {"anyOf": [{"type": "string", "maxLength": 4096}, {"type": "null"}]},
        "sources": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/source"}}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "path", "value", "candidates", "sources"],
      "properties": {
        "state": {"enum": ["selected", "unknown", "ambiguous"]},
        "path": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^/\\u0000-\\u001f\\\\]+(?:/[^/\\u0000-\\u001f\\\\]+)*$"
            },
            {"type": "null"}
          ]
        },
        "value": {"anyOf": [{"type": "string", "maxLength": 4096}, {"type": "null"}]},
        "candidates": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^/\\u0000-\\u001f\\\\]+(?:/[^/\\u0000-\\u001f\\\\]+)*$"
          }
        },
        "sources": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/source"}}
      }
    },
    "dirty_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "head_sha256", "staged_sha256", "worktree_sha256", "locator"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^/\\u0000-\\u001f\\\\]+(?:/[^/\\u0000-\\u001f\\\\]+)*$"
        },
        "kind": {"enum": ["staged", "unstaged", "staged_and_unstaged", "untracked"]},
        "head_sha256": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
        "staged_sha256": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
        "staged_content": {"anyOf": [{"type": "string", "maxLength": 262144}, {"type": "null"}]},
        "worktree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "retained_content": {"anyOf": [{"type": "string", "maxLength": 262144}, {"type": "null"}]},
        "patch": {"anyOf": [{"type": "string", "maxLength": 262144}, {"type": "null"}]},
        "locator": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "evidence_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "source", "evidence_ref", "evidence_sha256", "reviewer", "baseline_head", "status", "is_external"],
      "properties": {
        "statement": {"type": "string", "minLength": 1, "maxLength": 4096},
        "source": {"$ref": "#/$defs/source"},
        "evidence_ref": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^/\\u0000-\\u001f\\\\]+(?:/[^/\\u0000-\\u001f\\\\]+)*$"
            },
            {"type": "null"}
          ]
        },
        "evidence_sha256": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
        "reviewer": {"anyOf": [{"type": "string", "maxLength": 4096}, {"type": "null"}]},
        "baseline_head": {"anyOf": [{"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}, {"type": "null"}]},
        "status": {"enum": ["passed", "failed", "unknown", "unverified"]},
        "is_external": {"type": "boolean"}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "field", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 200},
        "severity": {"enum": ["info", "warning", "error"]},
        "field": {"type": "string", "minLength": 1, "maxLength": 4096},
        "message": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    }
  }
}
