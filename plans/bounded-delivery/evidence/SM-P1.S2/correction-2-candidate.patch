+    "issues"
+  ],
+  "properties": {
+    "schema_version": {
+      "enum": ["specmesh.handoff.v1"]
+    },
+    "state": {
+      "enum": ["ready", "rejected", "stale", "cancelled", "blocked", "unknown"]
+    },
+    "executable": {
+      "type": "boolean"
+    },
+    "project": {
+      "$ref": "#/$defs/identity"
