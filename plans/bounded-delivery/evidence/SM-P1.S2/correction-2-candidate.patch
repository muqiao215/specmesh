+"""Bounded extraction, rendering, and pre-consumption verification for SpecMesh handoff."""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+from pathlib import Path
+
+from .contracts_runtime import validate
+from .git_reader import read_git
+from .project_state import (
+    MarkdownStateSource,
+    _bounded,
+    _classifications,
+    _heading_key,
+    _source_text,
+    _statement,
+    _visible,
+)
+from .snapshot import DocumentSnapshot, MAX_DOCUMENT_BYTES
+
+HANDOFF_SCHEMA_VERSION = "specmesh.handoff.v1"
+
+
+def compute_scope_fingerprint(
+    observed_head: str | None,
+    coverage: list[dict[str, object]],
+    dirty_entries: list[dict[str, object]],
+    evidence_bindings: list[dict[str, object]],
+) -> str:
+    """Deterministic SHA-256 fingerprint over observed baseline, coverage, dirty state, and evidence."""
+    hasher = hashlib.sha256()
+    hasher.update((observed_head or "none").encode("utf-8"))
+    for item in sorted(coverage, key=lambda x: str(x.get("path", ""))):
+        hasher.update(
+            f"|cov:{item.get('path')}:{item.get('sha256')}:{item.get('tracked')}:{item.get('modified')}".encode("utf-8")
+        )
+    for item in sorted(dirty_entries, key=lambda x: str(x.get("path", ""))):
+        hasher.update(
+            f"|dirty:{item.get('path')}:{item.get('kind')}:{item.get('staged_sha256')}:{item.get('worktree_sha256')}".encode("utf-8")
+        )
+    for item in sorted(evidence_bindings, key=lambda x: str(x.get("evidence_ref") or x.get("statement", ""))):
+        hasher.update(
+            f"|ev:{item.get('evidence_ref')}:{item.get('evidence_sha256')}:{item.get('baseline_head')}:{item.get('status')}".encode("utf-8")
+        )
+    return hasher.hexdigest()
+
+
+def scan_git_dirty(
+    root: Path,
+    head: str | None,
+    task_path: str | None = None,
+    selected_paths: set[str] | None = None,
+) -> tuple[dict[str, int], list[dict[str, object]]]:
+    """Inspect staged, unstaged, and task-relevant untracked files using bounded git plumbing."""
+    if not head:
+        return {"staged_count": 0, "unstaged_count": 0, "untracked_count": 0}, []
+
+    stage_raw = read_git(root, "ls-files", "--stage", "-z")
+    index: dict[str, tuple[str, str]] = {}
+    for row in stage_raw.split(b"\0"):
+        if not row:
+            continue
+        header, _, name = row.partition(b"\t")
+        parts = header.decode("ascii").split()
+        if len(parts) == 3:
+            mode, oid, _ = parts
+            index[name.decode("utf-8")] = (mode, oid)
+
+    tree_raw = read_git(root, "ls-tree", "-r", "-z", "HEAD")
+    tree: dict[str, tuple[str, str]] = {}
+    for row in tree_raw.split(b"\0"):
+        if not row:
+            continue
+        header, _, name = row.partition(b"\t")
+        parts = header.decode("ascii").split()
+        if len(parts) == 3:
+            mode, _, oid = parts
+            tree[name.decode("utf-8")] = (mode, oid)
+
+    modified_raw = read_git(root, "ls-files", "--modified", "-z")
+    unstaged_paths = {p.decode("utf-8") for p in modified_raw.split(b"\0") if p}
+
+    other_raw = read_git(root, "ls-files", "--others", "--exclude-standard", "-z")
+    all_untracked = [p.decode("utf-8") for p in other_raw.split(b"\0") if p]
+
+    # Only include untracked files strictly within task scope or selected paths
+    untracked_paths: list[str] = []
+    for p in all_untracked:
+        is_in_task = bool(task_path and (p == task_path or p.startswith(task_path.rstrip("/") + "/")))
+        is_selected = bool(selected_paths and p in selected_paths)
+        if is_in_task or is_selected:
+            untracked_paths.append(p)
+
+    staged_paths: set[str] = set()
+    for path, entry in index.items():
+        if path not in tree or tree[path] != entry:
+            staged_paths.add(path)
+    for path in tree:
+        if path not in index:
+            staged_paths.add(path)
+
+    all_paths = sorted(staged_paths | unstaged_paths | set(untracked_paths))
+    # Bound dirty entries to 100 before schema validation
+    all_paths = all_paths[:100]
+
+    entries: list[dict[str, object]] = []
+
+    for path in all_paths:
+        is_staged = path in staged_paths
+        is_unstaged = path in unstaged_paths
+        is_untracked = path in untracked_paths
+
+        if is_staged and is_unstaged:
+            kind = "staged_and_unstaged"
+        elif is_staged:
+            kind = "staged"
+        elif is_unstaged:
+            kind = "unstaged"
+        elif is_untracked:
+            kind = "untracked"
+        else:
+            continue
+
+        staged_sha256 = None
+        staged_content = None
+        if is_staged and path in index:
+            _, oid = index[path]
+            try:
+                blob_bytes = read_git(root, "cat-file", "blob", oid)
+                staged_sha256 = hashlib.sha256(blob_bytes).hexdigest()
+                if len(blob_bytes) <= MAX_DOCUMENT_BYTES:
+                    try:
+                        staged_content = blob_bytes.decode("utf-8")
+                    except UnicodeDecodeError:
+                        staged_content = None
+            except Exception:
+                pass
+
+        full_file = root / path
+        worktree_sha256 = ""
+        retained_content = None
+
+        if full_file.is_file() and not full_file.is_symlink():
+            try:
+                st = full_file.stat()
+                if st.st_size <= MAX_DOCUMENT_BYTES:
+                    raw_bytes = full_file.read_bytes()
+                    worktree_sha256 = hashlib.sha256(raw_bytes).hexdigest()
+                    try:
+                        retained_content = raw_bytes.decode("utf-8")
+                    except UnicodeDecodeError:
+                        retained_content = None
+                else:
+                    hasher = hashlib.sha256()
+                    with open(full_file, "rb") as f:
+                        while chunk := f.read(65536):
+                            hasher.update(chunk)
+                    worktree_sha256 = hasher.hexdigest()
+            except OSError:
+                worktree_sha256 = hashlib.sha256(b"").hexdigest()
+        else:
+            worktree_sha256 = hashlib.sha256(b"").hexdigest()
+
+        head_sha256 = None
+        locator = f"file://{root.resolve()}/{path}"
+        entries.append({
+            "path": path,
+            "kind": kind,
+            "head_sha256": head_sha256,
+            "staged_sha256": staged_sha256,
+            "staged_content": staged_content,
+            "worktree_sha256": worktree_sha256,
+            "retained_content": retained_content,
+            "patch": None,
+            "locator": locator,
+        })
+
+    summary = {
+        "staged_count": len([e for e in entries if e["kind"] in ("staged", "staged_and_unstaged")]),
+        "unstaged_count": len([e for e in entries if e["kind"] in ("unstaged", "staged_and_unstaged")]),
+        "untracked_count": len([e for e in entries if e["kind"] == "untracked"]),
+    }
+    return summary, entries
+
+
+def extract_evidence_bindings(
+    sources: list[MarkdownStateSource],
+    repo_root: Path,
+) -> list[dict[str, object]]:
+    """Extract evidence statements and securely bind them to repository-internal evidence files."""
+    bindings: list[dict[str, object]] = []
+    seen_refs: set[str] = set()
+
+    for source in sources:
+        for heading in ("Evidence", "Verification", "验收", "已通过基线与尚未覆盖的条件", "本轮自查"):
+            for section in source.sections.get(_heading_key(heading), []):
+                for line, raw in section.rows:
+                    text = raw.strip()
+                    if not text or text.startswith("```") or text.startswith("|"):
+                        continue
+
+                    ref_path: str | None = None
+                    evidence_sha256: str | None = None
+                    reviewer: str | None = None
+                    baseline_head: str | None = None
+                    status = "unverified"
+                    is_external = False
+
+                    match = re.search(r"\[([^\]]+)\]\(([^)]+)\)", text)
+                    if match:
+                        link_target = match.group(2).split("#", 1)[0].strip()
+                        # Strictly reject absolute paths, external URLs, or path traversal
+                        if (not link_target.startswith("/") and "://" not in link_target
+                                and ".." not in Path(link_target).parts):
+                            src_dir = Path(source.path).parent
+                            candidate = (src_dir / link_target).as_posix()
+                            resolved = (repo_root / candidate).resolve()
+                            # Ensure resolution stays within authorized repository root
+                            if resolved.is_relative_to(repo_root.resolve()):
+                                ref_path = candidate
+
+                    if ref_path and ref_path not in seen_refs:
+                        seen_refs.add(ref_path)
+                        full_target = repo_root / ref_path
+                        if full_target.is_file() and not full_target.is_symlink():
+                            try:
+                                ev_bytes = full_target.read_bytes()
+                                if len(ev_bytes) <= MAX_DOCUMENT_BYTES:
+                                    evidence_sha256 = hashlib.sha256(ev_bytes).hexdigest()
+                                    ev_content = ev_bytes.decode("utf-8", errors="replace")
+                                    head_m = re.search(r"\b([0-9a-f]{40}|[0-9a-f]{64})\b", ev_content)
+                                    if head_m:
+                                        baseline_head = head_m.group(1)
+                                    reviewer_m = re.search(r"(?:审查者|reviewer|Reviewer)[：:\s]+([^\n,，;]+)", ev_content)
+                                    if reviewer_m:
+                                        reviewer = reviewer_m.group(1).strip()
+                                    # Text in markdown is asserted_candidate; never claim external verification
+                                    is_external = False
+                                    if re.search(r"\b(accepted|pass(?:ed)?)\b|通过|接受", ev_content, re.IGNORECASE):
+                                        status = "passed"
+                                    elif re.search(r"\b(failed|rejected)\b|失败|拒绝", ev_content, re.IGNORECASE):
+                                        status = "failed"
+                            except OSError:
+                                status = "failed"
+                        else:
+                            # Declared evidence file is missing
+                            status = "failed"
+
+                    if status == "unverified":
+                        t_lower = text.casefold()
+                        if "pass" in t_lower or "通过" in t_lower:
+                            status = "passed"
+                        elif "fail" in t_lower or "失败" in t_lower:
+                            status = "failed"
+                        elif "unknown" in t_lower or "未知" in t_lower:
+                            status = "unknown"
+
+                    bindings.append({
+                        "statement": text,
+                        "source": source.source(line),
+                        "evidence_ref": ref_path,
+                        "evidence_sha256": evidence_sha256,
+                        "reviewer": reviewer,
+                        "baseline_head": baseline_head,
+                        "status": status,
+                        "is_external": is_external,
+                    })
+    return bindings[:50]
+
+
+def build_handoff(
+    *,
+    project: MarkdownStateSource | None,
+    task_plan: MarkdownStateSource | None,
+    findings: MarkdownStateSource | None,
+    progress: MarkdownStateSource | None,
+    decisions_doc: MarkdownStateSource | None,
+    task_path: str | None,
+    observed_head: str | None,
+    expected_head: str,
+    coverage: list[dict[str, object]],
+    repo_root: Path,
+    issues: list[dict[str, object]],
+    selected_paths: set[str] | None = None,
+) -> dict[str, object]:
+    """Generate a bounded, verifiable handoff material conforming to specmesh.handoff.v1."""
+    project_title = project.title_statement() if project else None
+    task_title = task_plan.title_statement() if task_plan else None
+
+    if project_title and len(str(project_title["text"])) > 4096:
+        issues.append({"code": "handoff_statement_too_large", "severity": "warning", "field": "project_identity",
+                       "message": "Project identity exceeds the 4096-character output limit."})
+        project_title = None
+    if task_title and len(str(task_title["text"])) > 4096:
+        issues.append({"code": "handoff_statement_too_large", "severity": "warning", "field": "task",
+                       "message": "Task identity exceeds the 4096-character output limit."})
+        task_title = None
+
+    candidates = [] if task_path or project is None else project.linked_task_candidates()
+    if len(candidates) > 50:
+        issues.append({"code": "task_candidate_limit", "severity": "warning", "field": "task",
+                       "message": f"{len(candidates)} linked task candidates exceed the 50-item output limit."})
+        candidates = candidates[:50]
+
+    project_identity = {
+        "state": "known" if project_title else "unknown",
+        "value": project_title["text"] if project_title else None,
+        "sources": [project_title["source"]] if project_title else [],
+    }
+    if task_path:
+        task_state = "selected" if task_title else "unknown"
+    else:
+        task_state = "ambiguous" if len(candidates) > 1 else "unknown"
+
+    task = {
+        "state": task_state,
+        "path": task_path,
+        "value": task_title["text"] if task_title else None,
+        "candidates": candidates,
+        "sources": [task_title["source"]] if task_title else [],
+    }
+
+    goals = []
+    constraints = []
+    decisions = []
+    completed = []
+    failed = []
+    unknown_items = []
+    remaining_work = []
+    next_steps = []
+    blockers = []
+    declared_status = []
+
+    if project:
+        goals += project.statements("Why", "User Intent")
+        constraints += project.statements("Constraints", "Non-goals")
+    if decisions_doc:
+        for heading in decisions_doc.sections:
+            decisions += decisions_doc.statements(heading)
+    if task_plan:
+        goals += task_plan.statements("Goal", "Context", "目标、背景与边界", "可观察行为")
+        constraints += task_plan.statements(
+            "Requirements", "Constraints", "Non-goals", "当前不做", "每张卡共同执行约束",
+            "允许写范围", "权限、预算与停止",
+        )
+        remaining_work += task_plan.statements("Remaining", "待完成")
+        blockers += task_plan.statements("Issues", "Blockers")
+        declared_status += task_plan.statements("Status", "状态与唯一下一步")
+        next_steps += task_plan.statements("Next", "Next Step")
+    if progress:
+        blockers += progress.statements("Issues", "Blockers")
+        declared_status += progress.statements("Current")
+        completed += progress.statements("Done")
+        remaining_work += progress.statements("Remaining", "待完成")
+        next_steps = progress.statements("Next", "Next Step") or next_steps
+
+    for b in blockers:
+        b_text = str(b["text"]).casefold()
+        if re.search(r"\b(fail(?:ed|ure)?|blocked|error)\b|失败|阻塞|错误", b_text):
+            failed.append(b)
+        elif re.search(r"\bunknown\b|未知", b_text):
+            unknown_items.append(b)
+
+    goals = _bounded("goals", goals, issues)
+    constraints = _bounded("constraints", constraints, issues)
+    decisions = _bounded("decisions", decisions, issues)
+    completed = _bounded("work_summary.completed", completed, issues)
+    failed = _bounded("work_summary.failed", failed, issues)
+    unknown_items = _bounded("work_summary.unknown", unknown_items, issues)
+    remaining_work = _bounded("remaining_work", remaining_work, issues)
+    next_steps = _bounded("next_step", next_steps, issues)
+
+    if len(next_steps) == 1:
+        next_step_state = "selected"
+        sole_next_step = next_steps[0]
+        next_sources = [sole_next_step["source"]]
+    elif len(next_steps) > 1:
+        next_step_state = "ambiguous"
+        sole_next_step = None
+        next_sources = [ns["source"] for ns in next_steps[:10]]
+        issues.append({"code": "next_step_ambiguous", "severity": "warning", "field": "next_step",
+                       "message": f"Multiple ({len(next_steps)}) next steps declared; unambiguous sole step required."})
+    else:
+        next_step_state = "unknown"
+        sole_next_step = None
+        next_sources = []
+        issues.append({"code": "next_step_missing", "severity": "warning", "field": "next_step",
+                       "message": "No next step declared."})
+
+    next_step_model = {
+        "state": next_step_state,
+        "statement": sole_next_step,
+        "sources": next_sources,
+    }
+
+    ev_sources = [s for s in (progress, findings, task_plan) if s is not None]
+    evidence_bindings = extract_evidence_bindings(ev_sources, repo_root)
+
+    # Scan git dirty with explicit task path and selected paths
+    sel_set = set(selected_paths or [])
+    if task_path:
+        sel_set.add(task_path)
+    dirty_summary, dirty_entries = scan_git_dirty(repo_root, observed_head, task_path, sel_set)
+    is_clean = len(dirty_entries) == 0
+
+    head_matches = observed_head == expected_head if observed_head is not None else False
+    if not head_matches:
+        issues.append({"code": "head_stale", "severity": "error", "field": "baseline",
+                       "message": f"Observed HEAD {observed_head} does not match expected HEAD {expected_head}."})
+
+    scope_fingerprint = compute_scope_fingerprint(
+        observed_head,
+        coverage,
+        dirty_entries,
+        evidence_bindings,
+    )
+
+    is_cancelled = False
+    all_status_statements = declared_status + blockers
+    for stmt in all_status_statements:
+        text = str(stmt["text"]).casefold()
+        if re.search(r"\b(cancel(?:led|ed)?)\b|已取消|取消", text):
+            is_cancelled = True
+            break
+    if is_cancelled:
+        issues.append({"code": "task_cancelled", "severity": "warning", "field": "declared_status",
+                       "message": "Task is declared cancelled; handoff is non-executable."})
+
+    current_classes = _classifications(declared_status)
+    classes = current_classes | _classifications(blockers)
+    has_status_conflict = len(current_classes) > 1 or ("done" in classes and ("failed" in classes or "unknown" in classes))
+    if has_status_conflict:
+        issues.append({"code": "declared_status_conflict", "severity": "warning", "field": "declared_status",
+                       "message": "Conflicting status declarations coexisting with failed/unknown blockers."})
+
+    has_errors = any(item["severity"] == "error" for item in issues)
+    if has_errors:
+        state = "blocked"
+        executable = False
+    elif is_cancelled:
+        state = "cancelled"
+        executable = False
+    elif not head_matches or observed_head is None:
+        state = "stale"
+        executable = False
+    elif has_status_conflict or next_step_state != "selected" or task_state != "selected":
+        state = "rejected"
+        executable = False
+    elif not goals or not constraints or len(failed) > 0:
+        state = "rejected"
+        executable = False
+    else:
+        state = "ready"
+        executable = True
+
+    handoff = {
+        "schema_version": HANDOFF_SCHEMA_VERSION,
+        "state": state,
+        "executable": executable,
+        "project": project_identity,
+        "task": task,
+        "goals": goals,
+        "constraints": constraints,
+        "decisions": decisions,
+        "work_summary": {
+            "completed": completed,
+            "failed": failed,
+            "unknown": unknown_items,
+        },
+        "remaining_work": remaining_work,
+        "next_step": next_step_model,
+        "baseline": {
+            "observed_head": observed_head,
+            "expected_head": expected_head,
+            "head_matches": head_matches,
+            "scope_fingerprint": scope_fingerprint,
+        },
+        "dirty_coverage": {
+            "is_clean": is_clean,
+            "summary": dirty_summary,
+            "entries": dirty_entries,
+        },
+        "evidence_bindings": evidence_bindings,
+        "issues": issues,
+    }
+    return validate("specmesh-handoff", handoff)
+
+
+def verify_pre_consumption(handoff: dict[str, object], repo_root: Path) -> dict[str, object]:
+    """Strictly verify handoff material and live repository conditions before consumption."""
+    issues: list[dict[str, object]] = []
+
+    def issue(code: str, severity: str, field: str, message: str) -> None:
+        issues.append({"code": code, "severity": severity, "field": field, "message": message})
+
+    # 1. Strict schema validation
+    try:
+        validate("specmesh-handoff", handoff)
+    except Exception as exc:
+        issue("invalid_handoff_schema", "error", "schema", f"Handoff failed schema validation: {exc}")
+        return {
+            "schema_version": HANDOFF_SCHEMA_VERSION,
+            "verified": False,
+            "executable": False,
+            "state": "blocked",
+            "issues": issues,
+        }
+
+    if not repo_root.is_dir():
+        issue("repository_unavailable", "error", "repo_root", "Specified repository root does not exist.")
+        return {
+            "schema_version": HANDOFF_SCHEMA_VERSION,
+            "verified": False,
+            "executable": False,
+            "state": "blocked",
+            "issues": issues,
+        }
+
+    # 2. Check payload declared state
+    if handoff.get("state") == "cancelled":
+        issue("task_cancelled", "error", "task", "Handoff task was declared cancelled; rejecting execution.")
+    if not handoff.get("executable") or handoff.get("state") != "ready":
+        issue("handoff_not_ready", "error", "handoff", f"Handoff state '{handoff.get('state')}' is not executable.")
+
+    baseline = handoff.get("baseline", {})
+    expected_head = baseline.get("observed_head")
+
+    try:
+        current_head = read_git(repo_root, "rev-parse", "HEAD").decode().strip()
+    except Exception as exc:
+        issue("git_unavailable", "error", "baseline", str(exc))
+        current_head = None
+
+    if current_head != expected_head:
+        issue("head_stale", "error", "baseline",
+              f"Current HEAD {current_head} does not match handoff baseline HEAD {expected_head}.")
+
+    # 3. Live re-observation of sources, task cancellation, and status conflict via DocumentSnapshot
+    try:
+        with DocumentSnapshot(repo_root) as snapshot:
+            for item in baseline.get("coverage", []):
+                p = str(item.get("path", ""))
+                expected_sha = item.get("sha256")
+                try:
+                    raw = snapshot.read(p, optional=True)
+                    if raw is None:
+                        issue("source_file_missing", "error", "coverage", f"Covered source document '{p}' is missing.")
+                    else:
+                        actual_sha = hashlib.sha256(raw).hexdigest()
+                        if actual_sha != expected_sha:
+                            issue("source_content_modified_at_same_head", "error", "coverage",
+                                  f"Covered source '{p}' content changed at same HEAD (expected {expected_sha}, got {actual_sha}).")
+                except Exception as exc:
+                    issue("source_read_failed", "error", "coverage", f"Failed reading covered document '{p}': {exc}")
+
+            # Re-check live task documents for cancellation
+            task_path = handoff.get("task", {}).get("path")
+            if task_path:
+                task_plan_raw = snapshot.read(f"{task_path}/task_plan.md", optional=True)
+                progress_raw = snapshot.read(f"{task_path}/progress.md", optional=True)
+                combined_text = ((task_plan_raw or b"") + b"\n" + (progress_raw or b"")).decode("utf-8", errors="replace").casefold()
+                if re.search(r"\b(cancel(?:led|ed)?)\b|已取消|取消", combined_text):
+                    issue("task_cancelled_in_worktree", "error", "task",
+                          "Task has been declared cancelled in live repository worktree.")
+
+            snapshot.verify()
+    except Exception as exc:
+        issue("snapshot_verification_failed", "error", "coverage", f"Document snapshot failed revalidation: {exc}")
+
+    # 4. Check evidence files
+    evidence_bindings = handoff.get("evidence_bindings", [])
+    for ev in evidence_bindings:
+        ref = ev.get("evidence_ref")
+        exp_ev_sha = ev.get("evidence_sha256")
+        if ref:
+            ev_file = repo_root / ref
+            if not ev_file.is_file() or ev_file.is_symlink():
+                issue("evidence_file_missing", "error", "evidence", f"Evidence file '{ref}' is missing in worktree.")
+            else:
+                try:
+                    act_ev_sha = hashlib.sha256(ev_file.read_bytes()).hexdigest()
+                    if exp_ev_sha and act_ev_sha != exp_ev_sha:
+                        issue("evidence_file_modified", "error", "evidence",
+                              f"Evidence file '{ref}' content changed at same HEAD.")
+                except OSError as exc:
+                    issue("evidence_file_unreadable", "error", "evidence", f"Cannot read evidence file '{ref}': {exc}")
+        if ev.get("status") == "failed":
+            issue("evidence_failed", "error", "evidence", f"Evidence item '{ev.get('statement')}' is marked failed.")
+
+    # 5. Check staged index content and worktree dirty entries
+    try:
+        stage_raw = read_git(repo_root, "ls-files", "--stage", "-z")
+        live_index: dict[str, tuple[str, str]] = {}
+        for row in stage_raw.split(b"\0"):
+            if not row:
+                continue
+            header, _, name = row.partition(b"\t")
+            parts = header.decode("ascii").split()
+            if len(parts) == 3:
+                live_index[name.decode("utf-8")] = (parts[0], parts[1])
+    except Exception as exc:
+        issue("index_inspection_failed", "error", "dirty_coverage", str(exc))
+        live_index = {}
+
+    dirty_coverage = handoff.get("dirty_coverage", {})
+    entries = dirty_coverage.get("entries", [])
+    for entry in entries:
+        path_str = entry["path"]
+        expected_wt_sha = entry.get("worktree_sha256")
+        expected_st_sha = entry.get("staged_sha256")
+
+        # Check staged index sha
+        if expected_st_sha is not None:
+            if path_str not in live_index:
+                issue("staged_content_missing", "error", "dirty_coverage",
+                      f"File '{path_str}' is no longer staged in index.")
+            else:
+                _, oid = live_index[path_str]
+                try:
+                    blob = read_git(repo_root, "cat-file", "blob", oid)
+                    actual_st_sha = hashlib.sha256(blob).hexdigest()
+                    if actual_st_sha != expected_st_sha:
+                        issue("staged_content_mismatch", "error", "dirty_coverage",
+                              f"Staged index blob for '{path_str}' has changed.")
+                except Exception as exc:
+                    issue("staged_blob_read_failed", "error", "dirty_coverage", str(exc))
+
+        # Check worktree content
+        target_path = repo_root / path_str
+        if not target_path.exists():
+            issue("dirty_file_missing", "error", "dirty_coverage",
+                  f"Dirty file '{path_str}' is missing in worktree; new worktree does not automatically contain dirty state.")
+        else:
+            try:
+                actual_wt_sha = hashlib.sha256(target_path.read_bytes()).hexdigest()
+                if actual_wt_sha != expected_wt_sha:
+                    issue("dirty_hash_mismatch", "error", "dirty_coverage",
+                          f"Dirty file '{path_str}' content has changed at same HEAD.")
+            except OSError as exc:
+                issue("dirty_file_unreadable", "error", "dirty_coverage", f"Failed reading '{path_str}': {exc}")
+
+    # 6. Detect dirty coverage omissions within task scope
+    task_path = handoff.get("task", {}).get("path")
+    if current_head:
+        try:
+            _, live_dirty_entries = scan_git_dirty(
+                repo_root, current_head, task_path, set(handoff.get("task", {}).get("candidates", []))
+            )
+            live_dirty_paths = {e["path"] for e in live_dirty_entries}
+            handoff_dirty_paths = {e["path"] for e in entries}
+            omissions = live_dirty_paths - handoff_dirty_paths
+            if omissions:
+                issue("dirty_coverage_omission", "error", "dirty_coverage",
+                      f"Live task dirty files {sorted(omissions)} are omitted from handoff coverage.")
+        except Exception:
+            pass
+
+    # 7. Check next step
+    next_step = handoff.get("next_step", {})
+    if next_step.get("state") != "selected":
+        issue("next_step_invalid", "error", "next_step", "Handoff does not have a unique, selected next step.")
+
+    # 8. Recompute and verify scope fingerprint
+    if current_head:
+        try:
+            recomputed_fp = compute_scope_fingerprint(
+                current_head,
+                baseline.get("coverage", []),
+                entries,
+                evidence_bindings,
+            )
+            expected_fp = baseline.get("scope_fingerprint")
+            if recomputed_fp != expected_fp:
+                issue("scope_fingerprint_mismatch", "error", "baseline",
+                      f"Scope fingerprint mismatch (expected {expected_fp}, recomputed {recomputed_fp}).")
+        except Exception as exc:
+            issue("fingerprint_recomputation_failed", "error", "baseline", str(exc))
+
+    has_errors = any(i["severity"] == "error" for i in issues)
+    return {
+        "schema_version": HANDOFF_SCHEMA_VERSION,
+        "verified": not has_errors,
+        "executable": not has_errors,
+        "state": "blocked" if has_errors else "ready",
+        "issues": issues,
+    }
+
+
+def render_handoff(handoff: dict[str, object]) -> str:
+    """Render the handoff material in human-readable Markdown with safe character escaping."""
+    lines = [
+        "# SpecMesh handoff v1",
+        f"state: {_visible(handoff['state'])}",
+        f"executable: {str(handoff['executable']).lower()}",
+    ]
+    baseline = handoff["baseline"]
+    lines += [
+        f"observed_head: {_visible(baseline['observed_head'] or 'unknown')}",
+        f"expected_head: {_visible(baseline['expected_head'])}",
+        f"head_matches: {str(baseline['head_matches']).lower()}",
+        f"scope_fingerprint: {_visible(baseline['scope_fingerprint'])}",
+    ]
+
+    project, task = handoff["project"], handoff["task"]
+    p_sources = ", ".join(_source_text(s) for s in project["sources"]) or "no source"
+    t_sources = ", ".join(_source_text(s) for s in task["sources"]) or "no source"
+    lines += [
+        f"project: {_visible(project['value'] or 'unknown')} [{_visible(project['state'])}; {p_sources}]",
+        f"task: {_visible(task['value'] or 'unknown')} [{_visible(task['state'])}; {t_sources}]",
+        f"task_path: {_visible(task['path'] or 'unknown')}",
+    ]
+
+    next_step = handoff["next_step"]
+    lines.append(f"next_step_state: {_visible(next_step['state'])}")
+    if next_step["statement"]:
+        stmt = next_step["statement"]
+        lines.append(f"sole_next_step: {_visible(stmt['text'])} ({_source_text(stmt['source'])})")
+    else:
+        lines.append("sole_next_step: none")
+
+    for key, title in (
+        ("goals", "Goals"),
+        ("constraints", "Constraints"),
+        ("decisions", "Decisions"),
+        ("remaining_work", "Remaining work"),
+    ):
+        lines.append(f"\n## {title}")
+        rows = handoff.get(key, [])
+        if not rows:
+            lines.append("- unknown")
+        for row in rows:
+            lines.append(f"- {_visible(row['text'])} (authority:{_visible(row['authority'])}; {_source_text(row['source'])})")
+
+    lines.append("\n## Work summary")
+    ws = handoff["work_summary"]
+    lines.append("### Completed")
+    if not ws["completed"]:
+        lines.append("- none")
+    for row in ws["completed"]:
+        lines.append(f"- {_visible(row['text'])} ({_source_text(row['source'])})")
+
+    lines.append("### Failed")
+    if not ws["failed"]:
+        lines.append("- none")
+    for row in ws["failed"]:
+        lines.append(f"- {_visible(row['text'])} ({_source_text(row['source'])})")
+
+    lines.append("### Unknown")
+    if not ws["unknown"]:
+        lines.append("- none")
+    for row in ws["unknown"]:
+        lines.append(f"- {_visible(row['text'])} ({_source_text(row['source'])})")
+
+    lines.append("\n## Dirty coverage")
+    dc = handoff["dirty_coverage"]
+    lines.append(f"is_clean: {str(dc['is_clean']).lower()}")
+    sm = dc["summary"]
+    lines.append(f"staged: {sm['staged_count']}, unstaged: {sm['unstaged_count']}, untracked: {sm['untracked_count']}")
+    if not dc["entries"]:
+        lines.append("- clean worktree")
+    for entry in dc["entries"]:
+        st_sha = f" staged_sha256:{_visible(entry['staged_sha256'])}" if entry.get("staged_sha256") else ""
+        lines.append(
+            f"- {_visible(entry['path'])} [{_visible(entry['kind'])}]{st_sha} sha256:{_visible(entry['worktree_sha256'])} locator:{_visible(entry['locator'])}"
+        )
+
+    lines.append("\n## Evidence bindings")
+    eb = handoff.get("evidence_bindings", [])
+    if not eb:
+        lines.append("- none")
+    for row in eb:
+        reviewer_info = f" reviewer:{_visible(row['reviewer'])}" if row.get("reviewer") else ""
+        head_info = f" baseline_head:{_visible(row['baseline_head'])}" if row.get("baseline_head") else ""
+        sha_info = f" sha256:{_visible(row['evidence_sha256'])}" if row.get("evidence_sha256") else ""
+        lines.append(
+            f"- {_visible(row['statement'])} [status:{_visible(row['status'])}; external:{str(row['is_external']).lower()}{reviewer_info}{head_info}{sha_info}]"
+        )
+
+    lines.append("\n## Issues")
+    issues = handoff.get("issues", [])
+    if not issues:
+        lines.append("- none")
+    for item in issues:
+        lines.append(
+            f"- {_visible(item['severity'])} {_visible(item['code'])} [{_visible(item['field'])}]: {_visible(item['message'])}"
+        )
+
+    return "\n".join(lines) + "\n"
